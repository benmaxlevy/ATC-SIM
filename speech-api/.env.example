# Copy to speech-api/.env (gitignored). Settings.load() reads that file;
# variables already in the process environment win.
#
# Path C is optional and default off. Uncomment / keep PARSE_MODEL_ID to
# load the local Qwen2.5-1.5B instruct GGUF (~1–2B, not a 7B). Inference
# stays in this process. Do not point these at a paid LLM API.

PARSE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct-GGUF
PARSE_GGUF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf

# PARSE_N_GPU_LAYERS=-1
# PARSE_CTX=2048
# STT_MODEL_ID=Systran/faster-whisper-small.en
# TTS_VOICE=en_US-lessac-medium
# HOST=127.0.0.1
# PORT=8090
# HF_TOKEN=
