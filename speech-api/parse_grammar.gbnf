# Constrained JSON for POST /parse (Command IR v0).
# Used by llama.cpp GBNF. Browser still schema-checks.

root ::= ok-true-object | ok-false-object
ok-true-object ::= "{" ws ok-true "," ws callsign-field "," ws instructions-field ws "}"
ok-false-object ::= "{" ws ok-false "," ws error-field ws "}"
ok-true ::= "\"ok\"" ws ":" ws "true"
ok-false ::= "\"ok\"" ws ":" ws "false"
error-field ::= "\"error\"" ws ":" ws ("\"PARSE_MISS\"" | "\"UNAVAILABLE\"" | "\"SCHEMA\"" | "\"BAD_CLEARANCE\"")
callsign-field ::= "\"callsignToken\"" ws ":" ws (string | "null")
instructions-field ::= "\"instructions\"" ws ":" ws "[" ws instruction (ws "," ws instruction)* ws "]"

instruction ::= fly-heading | turn-degrees | present-heading | altitude | speed | direct | expect-approach | cleared-approach | cleared-visual | intercept-localizer | cancel-approach | assign-squawk | maintain-vfr | ifr-clearance | ident | say-heading | say-altitude | descend-via | climb-via | join-procedure | cross | go-around | delete-speed-restrictions | request-details | standby-request | approve-flight-following | decline-request | radar-contact | terminate-radar-service | acknowledge-ifr-cancellation

fly-heading ::= "{" ws "\"type\"" ws ":" ws "\"FLY_HEADING\"" ws "," ws "\"headingDeg\"" ws ":" ws number ws "," ws "\"turn\"" ws ":" ws turn-dir ws "}"
turn-degrees ::= "{" ws "\"type\"" ws ":" ws "\"TURN_DEGREES\"" ws "," ws "\"direction\"" ws ":" ws lr ws "," ws "\"degrees\"" ws ":" ws number ws "}"
present-heading ::= "{" ws "\"type\"" ws ":" ws "\"PRESENT_HEADING\"" ws "}"
altitude ::= "{" ws "\"type\"" ws ":" ws "\"ALTITUDE\"" ws "," ws "\"altitudeFt\"" ws ":" ws number ws "," ws "\"verb\"" ws ":" ws alt-verb (ws "," ws "\"expedite\"" ws ":" ws boolean)? (ws "," ws "\"untilEstablished\"" ws ":" ws boolean)? ws "}"
speed ::= "{" ws "\"type\"" ws ":" ws "\"SPEED\"" ws "," ws "\"speedKt\"" ws ":" ws number ws "," ws "\"verb\"" ws ":" ws speed-verb (ws "," ws "\"until\"" ws ":" ws speed-until)? ws "}"
direct ::= "{" ws "\"type\"" ws ":" ws "\"DIRECT\"" ws "," ws "\"fixId\"" ws ":" ws string ws "}"
expect-approach ::= "{" ws "\"type\"" ws ":" ws "\"EXPECT_APPROACH\"" ws "," ws "\"approachId\"" ws ":" ws string ws "}"
cleared-approach ::= "{" ws "\"type\"" ws ":" ws "\"CLEARED_APPROACH\"" ws "," ws "\"approachId\"" ws ":" ws string ws "}"
cleared-visual ::= "{" ws "\"type\"" ws ":" ws "\"CLEARED_VISUAL\"" ws "," ws "\"runwayId\"" ws ":" ws string ws "}"
intercept-localizer ::= "{" ws "\"type\"" ws ":" ws "\"INTERCEPT_LOCALIZER\"" ws "," ws "\"approachId\"" ws ":" ws string ws "}"
cancel-approach ::= "{" ws "\"type\"" ws ":" ws "\"CANCEL_APPROACH\"" ws "}"
assign-squawk ::= "{" ws "\"type\"" ws ":" ws "\"ASSIGN_SQUAWK\"" ws "," ws "\"code\"" ws ":" ws octal-code ws "," ws "\"source\"" ws ":" ws squawk-source ws "}"
maintain-vfr ::= "{" ws "\"type\"" ws ":" ws "\"MAINTAIN_VFR\"" ws "}"
ifr-clearance ::= "{" ws "\"type\"" ws ":" ws "\"IFR_CLEARANCE\"" ws "," ws "\"limitId\"" ws ":" ws string ws "," ws "\"access\"" ws ":" ws clearance-access (ws "," ws "\"altitudeFt\"" ws ":" ws number)? (ws "," ws "\"climbVia\"" ws ":" ws boolean)? (ws "," ws "\"frequency\"" ws ":" ws string)? (ws "," ws "\"squawk\"" ws ":" ws octal-code)? ws "}"
clearance-access ::= as-filed-access | direct-access | fix-then-direct-access | radar-vectors-access | sid-access | explicit-route-access
as-filed-access ::= "{" ws "\"type\"" ws ":" ws "\"AS_FILED\"" ws "}"
direct-access ::= "{" ws "\"type\"" ws ":" ws "\"DIRECT\"" ws "}"
fix-then-direct-access ::= "{" ws "\"type\"" ws ":" ws "\"FIX_THEN_DIRECT\"" ws "," ws "\"fixId\"" ws ":" ws string ws "}"
radar-vectors-access ::= "{" ws "\"type\"" ws ":" ws "\"RADAR_VECTORS\"" ws "}"
sid-access ::= "{" ws "\"type\"" ws ":" ws "\"SID\"" ws "," ws "\"procedureId\"" ws ":" ws string (ws "," ws "\"transitionId\"" ws ":" ws string)? ws "}"
explicit-route-access ::= "{" ws "\"type\"" ws ":" ws "\"EXPLICIT_ROUTE\"" ws "," ws "\"segments\"" ws ":" ws "[" ws route-segments ws "]" ws "}"
route-segments ::= (route-segment (ws "," ws route-segment)*)?
route-segment ::= direct-segment | procedure-segment
direct-segment ::= "{" ws "\"type\"" ws ":" ws "\"DIRECT\"" ws "," ws "\"fixId\"" ws ":" ws string ws "}"
procedure-segment ::= "{" ws "\"type\"" ws ":" ws "\"PROCEDURE\"" ws "," ws "\"procedureId\"" ws ":" ws string (ws "," ws "\"transitionId\"" ws ":" ws string)? ws "}"
ident ::= "{" ws "\"type\"" ws ":" ws "\"IDENT\"" ws "}"
say-heading ::= "{" ws "\"type\"" ws ":" ws "\"SAY_HEADING\"" ws "}"
say-altitude ::= "{" ws "\"type\"" ws ":" ws "\"SAY_ALTITUDE\"" ws "}"
descend-via ::= "{" ws "\"type\"" ws ":" ws "\"DESCEND_VIA\"" ws "," ws "\"procedureId\"" ws ":" ws string (ws "," ws "\"transitionId\"" ws ":" ws string)? ws "}"
climb-via ::= "{" ws "\"type\"" ws ":" ws "\"CLIMB_VIA\"" ws "," ws "\"procedureId\"" ws ":" ws string (ws "," ws "\"transitionId\"" ws ":" ws string)? ws "}"
join-procedure ::= "{" ws "\"type\"" ws ":" ws "\"JOIN_PROCEDURE\"" ws "," ws "\"procedureId\"" ws ":" ws string (ws "," ws "\"transitionId\"" ws ":" ws string)? ws "}"
cross ::= "{" ws "\"type\"" ws ":" ws "\"CROSS\"" ws "," ws "\"fixId\"" ws ":" ws string ws "," ws "\"altitudeFt\"" ws ":" ws number ws "," ws "\"restriction\"" ws ":" ws cross-restriction ws "}"
go-around ::= "{" ws "\"type\"" ws ":" ws "\"GO_AROUND\"" ws "}"
delete-speed-restrictions ::= "{" ws "\"type\"" ws ":" ws "\"DELETE_SPEED_RESTRICTIONS\"" ws "}"
request-details ::= "{" ws "\"type\"" ws ":" ws "\"REQUEST_DETAILS\"" ws "}"
standby-request ::= "{" ws "\"type\"" ws ":" ws "\"STANDBY_REQUEST\"" ws "}"
approve-flight-following ::= "{" ws "\"type\"" ws ":" ws "\"APPROVE_FLIGHT_FOLLOWING\"" ws "}"
decline-request ::= "{" ws "\"type\"" ws ":" ws "\"DECLINE_REQUEST\"" ws "," ws "\"service\"" ws ":" ws decline-service ws "}"
decline-service ::= "\"FLIGHT_FOLLOWING\"" | "\"IFR_PICKUP\""
radar-contact ::= "{" ws "\"type\"" ws ":" ws "\"RADAR_CONTACT\"" ws "," ws "\"distanceNm\"" ws ":" ws number ws "," ws "\"referenceId\"" ws ":" ws string ws "," ws "\"referenceKind\"" ws ":" ws ref-kind ws "}"
ref-kind ::= "\"FIX\"" | "\"NAVAID\""
terminate-radar-service ::= "{" ws "\"type\"" ws ":" ws "\"TERMINATE_RADAR_SERVICE\"" ws "}"
acknowledge-ifr-cancellation ::= "{" ws "\"type\"" ws ":" ws "\"ACKNOWLEDGE_IFR_CANCELLATION\"" ws "}"

speed-until ::= speed-until-faf | speed-until-fix | speed-until-dme
speed-until-faf ::= "{" ws "\"type\"" ws ":" ws "\"FAF\"" ws "}"
speed-until-fix ::= "{" ws "\"type\"" ws ":" ws "\"FIX\"" ws "," ws "\"fixId\"" ws ":" ws string ws "}"
speed-until-dme ::= "{" ws "\"type\"" ws ":" ws "\"DME\"" ws "," ws "\"distanceNm\"" ws ":" ws number ws "}"

turn-dir ::= "\"LEFT\"" | "\"RIGHT\"" | "\"SHORTEST\""
lr ::= "\"LEFT\"" | "\"RIGHT\""
alt-verb ::= "\"CLIMB\"" | "\"DESCEND\"" | "\"MAINTAIN\""
speed-verb ::= "\"MAINTAIN\"" | "\"INCREASE\"" | "\"REDUCE\""
cross-restriction ::= "\"AT\"" | "\"AT_OR_ABOVE\"" | "\"AT_OR_BELOW\""
squawk-source ::= "\"DISCRETE\"" | "\"VFR\""
octal-code ::= "\"" octal-digit octal-digit octal-digit octal-digit "\""
octal-digit ::= [0-7]
boolean ::= "true" | "false"

number ::= "-"? [0-9]+ ("." [0-9]+)?
string ::= "\"" chars "\""
chars ::= char*
char ::= [^"\\] | "\\" escape
escape ::= ["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]
ws ::= [ \t\n\r]*
