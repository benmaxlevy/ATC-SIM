# Copy to speech-api/.env (gitignored). Settings.load() reads that file;
# variables already in the process environment win.
#
# Mandatory Path C loads this local Qwen3 4B instruct GGUF by default.
# Override only to use another local GGUF or public Hub weight. Inference
# stays in this process. Do not point these at a paid LLM API.

# PARSE_MODEL_ID=MaziyarPanahi/Qwen3-4B-Instruct-2507-GGUF
# PARSE_GGUF_FILE=Qwen3-4B-Instruct-2507.Q4_K_M.gguf
PARSE_MODEL_ID=empero-ai/Qwen3.8-2B-Distill-GGUF
PARSE_GGUF_FILE=Qwen3.8-2B-Q4_K_M.gguf

# PARSE_N_GPU_LAYERS=-1
# PARSE_CTX=2048
# STT_MODEL_ID=Qwen/Qwen3-ASR-1.7B
# STT_DEVICE=cuda
# TTS_VOICE=en_US-lessac-medium
# HOST=127.0.0.1
# PORT=8090
# HF_TOKEN=
